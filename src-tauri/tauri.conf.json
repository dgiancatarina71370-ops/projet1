  "productName": "BA-Mentor",
  "version": "0.2.4",
  "identifier": "fr.giancatarina.bamentor",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
